# Copy to hpc/secrets.env and fill in. This file is gitignored.
#   cp hpc/secrets.env.example hpc/secrets.env && chmod 600 hpc/secrets.env
#
# Workers call GWDG directly with ONE key (no router). env.sh uses GWDG_API_KEY
# if set, else falls back to GWDG_API_KEY_1. Key 1 has the highest daily budget
# (1200/day), so it's the sensible single key. GWDG_API_KEY_2/3 are optional and
# currently unused (kept here in case you later rotate or round-robin keys).
export GWDG_API_KEY_1="paste-gwdg-key-1-here"
# export GWDG_API_KEY_2="paste-gwdg-key-2-here"   # optional, unused
# export GWDG_API_KEY_3="paste-gwdg-key-3-here"   # optional, unused
